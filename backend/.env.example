# SmartLog AI backend configuration — copy to backend/.env and fill in.
# NEVER commit backend/.env or print real secret values.

# Anthropic Claude API key for the LLM fallback stage.
# Missing key is fine: the pipeline degrades to "Unknown" gracefully.
ANTHROPIC_API_KEY=

# Database URL (optional; defaults to backend/smartlog.db SQLite file).
# DATABASE_URL=sqlite:///smartlog.db

# Web scraper safety (POST /api/scrape). Default true so localhost demo
# targets work. MUST be set to false when the backend runs on a public host,
# or it could be used as an SSRF proxy into your intranet.
SCRAPE_ALLOW_PRIVATE=true
